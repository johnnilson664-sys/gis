        <mxCell id="admin2-0378" value="Основной и резервный ЦОД находятся на разных площадках; резервная площадка показана на листе 04.&#10;А205 — рабочая роль редактора в составе Единого деканата. Дополнительный «отдел сайта» не вводится.&#10;Лестницы А107 и А207 совпадают в плане. На втором этаже нет дополнительного входа снаружи." style="shadow=0;glass=0;text;html=0;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#526373;fontStyle=0;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="admin2-layer-labels">
          <mxGeometry x="80" y="1022" width="1084" height="83" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
