        </mxCell>
        <mxCell id="admin1-0354" value="Общая КЗ1 охватывает весь корпус; пунктир проведён с внутренним отступом от стен.&#10;В А101 зона приёма отделена от служебных РМ; проход к обработке ПДн — через карточную дверь.&#10;Доступ по персональным картам и спискам допуска. ТК — тонкие клиенты; серверная часть ИСПДн размещена в ЦОД." style="shadow=0;glass=0;text;html=0;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#526373;fontStyle=0;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="admin1-layer-labels">
          <mxGeometry x="80" y="1022" width="1084" height="83" as="geometry"/>
        </mxCell>
