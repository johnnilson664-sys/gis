        <mxCell id="admin1-0338" value="Посетитель допускается через КПП по разовому&#10;разрешению. В служебные кабинеты — с&#10;сопровождением." style="shadow=0;glass=0;text;html=0;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#526373;fontStyle=0;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="admin1-layer-labels">
